# Local development. Copy to .env; never commit .env.
PORT=3000
MAX_VIEWERS=10
# Optional local, REQUIRED for public deployment. Share URLs contain this key.
ACCESS_KEY=
CORS_ORIGIN=
TURN_HOST=localhost
TURN_PORT=3478
TURN_SECRET=change-me-generate-a-random-secret
TURN_REALM=webrtc.local
TURN_EXTERNAL_IP=127.0.0.1
TURN_TTL_SECONDS=3600
# Public deployment: actual domain/IP/email are required.
PUBLIC_DOMAIN=
ACME_EMAIL=
