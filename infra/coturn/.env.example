# Public-only host: 203.0.113.10
# NAT host: 203.0.113.10/192.168.10.20
TURN_EXTERNAL_IP=203.0.113.10/192.168.10.20
TURN_REALM=turn.example.com
TURN_SHARED_SECRET=replace-with-the-same-random-secret-as-the-backend
TURN_TLS_CERT_PATH=/etc/letsencrypt/live/turn.example.com/fullchain.pem
TURN_TLS_KEY_PATH=/etc/letsencrypt/live/turn.example.com/privkey.pem
