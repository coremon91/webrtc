# Local development. Copy to .env; never commit .env.
PORT=3000
MAX_VIEWERS=10
# Optional local, REQUIRED for public deployment. Share URLs contain this key.
ACCESS_KEY=
CORS_ORIGIN=
TURN_HOST=localhost
TURN_PORT=3478
TURN_SECRET=change-me-generate-a-random-secret
TURN_REALM=webrtc.local
TURN_EXTERNAL_IP=127.0.0.1
TURN_TTL_SECONDS=3600
# Public deployment: actual domain/IP required; certificate contact email optional.
PUBLIC_DOMAIN=
ACME_EMAIL=
# Leave blank for production. Use staging while testing external connectivity.
ACME_CA=

# Relay ports below Windows dynamic UDP range (49152+).
TURN_MIN_PORT=40000
TURN_MAX_PORT=40249
